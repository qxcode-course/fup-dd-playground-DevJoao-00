            "label": "2026-07-06_20-08-12",
            "content": "package main\nimport \"fmt\"\n\nfunc invert(s []byte, i, j int) {\n    for i < j {\n        s[i], s[j] = s[j], s[i]\n\n        i++\n        j--\n    }\n}\n\nfunc proxPermut(s []byte) bool{\n    n := len(s)\n\n    i := n - 2\n    \n    for i >= 0 && s[i] >= s[i + 1]{\n        i--\n    }\n\n    if i < 0 {\n        return false\n    }\n\n    j := n - 1\n\n    for s[j] <= s[i] {\n        j--\n    }\n\n    s[i], s[j] = s[j], s[i]\n\n    invert(s, i + 1, n - 1)\n\n    return true\n}\nfunc main() {\n    var ficha string\n    var n int\n\n    fmt.Scan(&ficha, &n)\n\n    s := []byte(ficha)\n\n    for i := 0; i < n; i++{\n        if !proxPermut(s){\n            break\n        }\n    }\n        fmt.Println(string(s))\n}\n",
